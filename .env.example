# (선택) 이 파일을 .env 로 복사한 뒤 필요한 값만 채우세요. 비워두면 해당 기능 없이 동작합니다.
# .env 는 git 에 올라가지 않습니다.
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env

# 서비스 주소 – 소셜 로그인을 쓸 때 카카오/구글 콘솔에 등록하는 Redirect URI 의 앞부분과 같아야 합니다
BASE_URL=http://localhost:3000

# 카카오 (https://developers.kakao.com → 내 애플리케이션 → 앱 키)
#   REST API 키: 동네 이름 조회 (+ 카카오 로그인 버튼)
#   JavaScript 키: 카카오맵 표시
KAKAO_REST_KEY=
KAKAO_JS_KEY=
# 카카오 로그인 → 보안 → Client Secret 을 '사용'으로 켠 경우에만 입력
KAKAO_CLIENT_SECRET=

# 구글 로그인 버튼 (https://console.cloud.google.com/apis/credentials → OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 배포 시 HTTPS 를 쓴다면 production 으로 (쿠키 Secure 플래그)
# NODE_ENV=production
